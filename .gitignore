# Ignore everything in the root
/*

# Explicitly allow these files and directories
!/data/
!/mock_data/
!/workflow/
!/tools/
!/app.py
!/.env.example
!/.gitignore
!/README.md
!/requirements.txt
!/pages/



# Standard Python ignores (for allowed subdirectories)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
